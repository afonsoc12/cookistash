# Copy this file to .env and fill in the values you need.
# .env is gitignored - never commit real secrets.

# Cookidoo market "explore" page URL, e.g. https://cookidoo.pt/foundation/pt-PT/explore
# Required to enable scraping. See README for details.
COOKIDOO_EXPLORE_URL=

# Mealie sync (optional) - only activates once MEALIE_API_URL and
# MEALIE_API_TOKEN are both set. Generate the token in Mealie's UI
# (Profile > API Tokens) after first login. See README for details.
MEALIE_API_URL=http://mealie:9000
MEALIE_PUBLIC_URL=http://localhost:9000
MEALIE_GROUP_SLUG=home
MEALIE_API_TOKEN=
