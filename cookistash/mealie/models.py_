from django.db import models
from uuid import uuid4

from cookidoo_scrapper.cookidoo.models import ScrapedRecipe
from cookidoo_scrapper.cookidoo.models import Recipe as CookidooRecipe


class Food(models.Model):
    name = models.CharField(primary_key=True, max_length=100)
    description = models.TextField(blank=True, null=True)
    extras = models.JSONField(default=dict, blank=True)
    aliases = models.JSONField(default=list, blank=True)
    plural_name = models.CharField(max_length=100, blank=True, null=True)
    label_id = models.CharField(max_length=50, blank=True, null=True)


class Unit(models.Model):
    id = models.UUIDField(primary_key=True, default=uuid4, editable=False)
    name = models.CharField(max_length=50)
    description = models.TextField(blank=True, null=True)
    abbreviation = models.CharField(max_length=20, blank=True, null=True)
    plural_abbreviation = models.CharField(max_length=20, blank=True, null=True)
    use_abbreviation = models.BooleanField(default=True)
    fraction = models.BooleanField(default=False)
    aliases = models.JSONField(default=list, blank=True)


class Ingredient(models.Model):
    quantity = models.FloatField(null=True, blank=True)
    unit = models.ForeignKey(Unit, on_delete=models.SET_NULL, null=True)
    food = models.ForeignKey(Food, on_delete=models.SET_NULL, null=True)
    note = models.CharField(max_length=200, blank=True)
    display = models.CharField(max_length=200, blank=True)
    title = models.CharField(max_length=100, blank=True)
    original_text = models.TextField(blank=True, null=True)


class Instruction(models.Model):
    title = models.CharField(max_length=100, blank=True)
    summary = models.CharField(max_length=200)
    text = models.TextField()
    ingredient_refs = models.JSONField(default=list, blank=True)


class Notes(models.Model):
    title = models.CharField(max_length=100)
    text = models.TextField()


class Tag(models.Model):
    name = models.CharField(max_length=100)
    slug = models.SlugField(blank=True, null=True)


class Category(models.Model):
    name = models.CharField(max_length=100)
    slug = models.SlugField(blank=True, null=True)


class Settings(models.Model):
    public = models.BooleanField(default=False)
    show_nutrition = models.BooleanField(default=True)
    show_assets = models.BooleanField(default=True)
    landscape_view = models.BooleanField(default=False)
    disable_comments = models.BooleanField(default=False)
    disable_amount = models.BooleanField(default=False)
    locked = models.BooleanField(default=False)


class Recipe(models.Model):
    """Normalized Mealie-compatible recipe"""
    recipe = models.ForeignKey(CookidooRecipe, on_delete=models.CASCADE, related_name="mealie_versions")
    scraped_recipe = models.ForeignKey(ScrapedRecipe, on_delete=models.SET_NULL, null=True, blank=True)

    ck_id = models.CharField(max_length=20, unique=True)
    name = models.CharField(max_length=200)
    image_url = models.URLField(blank=True, null=True)
    org_url = models.URLField(blank=True, null=True)
    servings = models.PositiveIntegerField(null=True, blank=True)
    yield_quantity = models.PositiveIntegerField(null=True, blank=True)
    yield_unit = models.CharField(max_length=50, blank=True)
    total_time = models.CharField(max_length=50, blank=True)
    prep_time = models.CharField(max_length=50, blank=True)
    description = models.TextField(blank=True)

    category = models.ForeignKey(Category, on_delete=models.SET_NULL, null=True)
    tags = models.ManyToManyField(Tag, blank=True)
    ingredients = models.ManyToManyField(Ingredient, blank=True)
    instructions = models.ManyToManyField(Instruction, blank=True)
    notes = models.ManyToManyField(Notes, blank=True)
    settings = models.OneToOneField(Settings, on_delete=models.CASCADE, null=True)

    created_at = models.DateTimeField(auto_now_add=True)
    approved = models.BooleanField(default=False)

    def __str__(self):
        return f"{self.name} ({self.ck_id})"
